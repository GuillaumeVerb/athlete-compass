# --- Futur V2+ (optionnel) : ne rien renseigner pour la V1 locale ---
# URL canonique de l'app (succès / annulation Stripe, sitemap, canonical blog, liens absolus)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel : persistance des PDF rapport (Storage). Créer le bucket `report-pdfs` (voir migrations/009).
SUPABASE_REPORT_PDF_BUCKET=

# Stripe
STRIPE_SECRET_KEY=
# Signature cookie déblocage `/report` — sinon dérivée de STRIPE_SECRET_KEY (serveur uniquement).
PURCHASE_SIGNING_SECRET=
# Local : `pnpm stripe:listen` → copier le signing secret (whsec_…) ici.
# Prod : endpoint dashboard → https://<domaine>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Optionnel (Hosted Checkout actuel n’en a pas besoin ; utile pour Stripe.js plus tard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (mode test) — un par offre alignée produit
# Création auto en local : `pnpm stripe:seed-catalog` (lit STRIPE_SECRET_KEY dans .env)
STRIPE_PRICE_BILAN_9=
STRIPE_PRICE_PLAN_19=
STRIPE_PRICE_PACK_29=

# Email post-achat (optionnel — Resend)
RESEND_API_KEY=
# Ex. dev : onboarding@resend.dev — prod : ton domaine vérifié
RESEND_FROM_EMAIL=

# Cron rappels retest (optionnel). Sur Vercel : définis aussi CRON_SECRET dans
# Project Settings → Environment Variables ; Vercel envoie alors automatiquement
# Authorization: Bearer <CRON_SECRET> sur les invocations de vercel.json → crons.
# En local : curl -H "Authorization: Bearer $CRON_SECRET" … (voir README si besoin).
CRON_SECRET=

