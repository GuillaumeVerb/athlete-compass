# --- Futur V2+ (optionnel) : ne rien renseigner pour la V1 locale ---
# URL canonique de l’app (succès / annulation Stripe, liens absolus)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (mode test) — un par offre alignée produit
STRIPE_PRICE_BILAN_9=
STRIPE_PRICE_PLAN_19=
STRIPE_PRICE_PACK_29=

# Email post-achat (optionnel — Resend)
RESEND_API_KEY=
# Ex. dev : onboarding@resend.dev — prod : ton domaine vérifié
RESEND_FROM_EMAIL=

# Cron rappels retest (optionnel). Sur Vercel : définis aussi CRON_SECRET dans
# Project Settings → Environment Variables ; Vercel envoie alors automatiquement
# Authorization: Bearer <CRON_SECRET> sur les invocations de vercel.json → crons.
# En local : curl -H "Authorization: Bearer $CRON_SECRET" … (voir README si besoin).
CRON_SECRET=

